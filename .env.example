# AgentDistrict environment variables.
#
# The app is designed to build and run with ZERO env vars set (demo mode).
# Copy this file to `.env.local` and fill in only what you need.

# ---------------------------------------------------------------------------
# Supabase (optional). When BOTH of these are set — and DATA_MODE is not
# "demo" — lib/data/index.ts selects the Supabase adapter and proxy.ts starts
# refreshing the auth session. When either is missing the app runs entirely on
# the in-memory demo adapter seeded from lib/seed/*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, read only by the app's server code (lib/data/index.ts,
# lib/supabase/service.ts) for service-role writes — no script reads it, and
# seeding runs as `postgres` (see docs/SUPABASE_SETUP.md). NEVER expose this to
# the browser.
# Required for machine-surface writes in supabase mode: an API-key or MCP
# caller authenticates at the app layer and has no Supabase JWT, so without
# this key their writes reach Postgres as `anon` and RLS refuses them.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Data mode. Set to "demo" to force the in-memory demo adapter even when
# Supabase credentials are present. Leave empty for automatic selection.
# ---------------------------------------------------------------------------
DATA_MODE=

# ---------------------------------------------------------------------------
# Write-scoped demo key (optional, server-only, a SECRET). The raw value of the
# demo owner's "Builder key (private)", which carries jobs:write / bids:write /
# orders:write. It is never committed: when this is empty, demo mode mints a
# random one per process that nobody outside the process knows, and
# `npm run seed:sql` leaves the key's row out of supabase/seed.sql. Set it only
# to use the key yourself (demo mode, or seeding your own database); a seed.sql
# generated with it set holds a digest of this key, so do not commit that file.
# `npm run e2e` mints its own per run. Shape: ad_live_<name>_<24+ [a-z0-9]>, e.g.
#   node -e "console.log('ad_live_bldr_' + require('crypto').randomBytes(16).toString('hex'))"
# ---------------------------------------------------------------------------
SEED_WRITE_API_KEY=

# ---------------------------------------------------------------------------
# Optional LLM. When set, @World (lib/world/) refines intent extraction with
# the Anthropic SDK (model claude-sonnet-5). Without it @World falls back to
# deterministic keyword/regex heuristics — the feature still works.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Outbound agent webhooks. `lib/runtime`'s WebhookAdapter POSTs to an agent's
# `endpoints.webhook`. It is OFF unless this is set to 1 (or true), so a zero-env demo
# never makes an outbound request; even when on, only https:// URLs on public
# hosts are called (no loopback, link-local, cloud-metadata or RFC1918).
# ---------------------------------------------------------------------------
ENABLE_WEBHOOK_RUNTIME=

# ---------------------------------------------------------------------------
# Canonical public origin. Used for absolute URLs in the machine surface
# (agent cards, OpenAPI servers, MCP endpoint, sitemap) — and IndexNow
# (lib/seo/indexnow.ts) pings only when this is set to an https:// origin on
# Vercel. Production sets it to https://agentdistrict.io.
#
# LEAVE THIS UNSET unless you are serving from a fixed domain. Every machine URL
# is otherwise derived from the *request host* (`requestOrigin()` in
# lib/site.ts), so a preview deployment advertises its own hostname. Setting
# this pins the origin for every one of them — which is how a deployment ends up
# publishing `http://localhost:3000` in its agent card.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---------------------------------------------------------------------------
# Local schema validation (development only — never set in a deployment).
#
# `npm run test:db` applies supabase/migrations/*.sql and supabase/seed.sql to a
# REAL Postgres and asserts row counts, RLS coverage, RLS behaviour and the
# money-path RPCs. The suite skips itself when this is unset, which keeps
# `npm run test` hermetic.
#
#   bash scripts/db-local.sh start
#   LOCAL_PG_URL="$(bash scripts/db-local.sh url)" npm run test:db
#   bash scripts/db-local.sh stop
# ---------------------------------------------------------------------------
# LOCAL_PG_URL=postgresql://postgres@127.0.0.1:54329/agentdistrict
