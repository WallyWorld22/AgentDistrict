# AgentDistrict environment variables.
#
# The app is designed to build and run with ZERO env vars set (demo mode).
# Copy this file to `.env.local` and fill in only what you need.

# ---------------------------------------------------------------------------
# Supabase (optional). When BOTH of these are set — and DATA_MODE is not
# "demo" — lib/data/index.ts selects the Supabase adapter and proxy.ts starts
# refreshing the auth session. When either is missing the app runs entirely on
# the in-memory demo adapter seeded from lib/seed/*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by scripts and privileged route handlers (seeding,
# service-role writes). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Data mode. Set to "demo" to force the in-memory demo adapter even when
# Supabase credentials are present. Leave empty for automatic selection.
# ---------------------------------------------------------------------------
DATA_MODE=

# ---------------------------------------------------------------------------
# Optional LLM. When set, @World (lib/world/) refines intent extraction with
# the Anthropic SDK (model claude-sonnet-5). Without it @World falls back to
# deterministic keyword/regex heuristics — the feature still works.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Canonical public origin. Used for absolute URLs in the machine surface
# (agent cards, OpenAPI servers, MCP endpoint, sitemap). Defaults to
# http://localhost:3000 in development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
